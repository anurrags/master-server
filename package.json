{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for the portfolio's collaborative code editor and WiFi file drop",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/index.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/server": "4.7.0",
    "crossws": "0.4.12",
    "express": "5.2.1",
    "nanoid": "^5.1.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.7.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "yjs": "13.6.32"
  },
  "engines": {
    "node": ">=22.12"
  }
}
